[sub_resource type="GDScript" id="GDScript_ebmjs"]
resource_name = "Move"
script/source = "extends CharacterBody2D

#The speed of the character in pixels per second
@export var DEFAULT_SPEED: int = 200
@export var SPRINT_MULT: float = 1.75

#The last moved direction
var last_direction

#Player sprite
@onready var animated_sprite_2d: AnimatedSprite2D = $AnimatedSprite2D

func _physics_process(delta: float) -> void:
	
	#The movement speed
	var speed
	
	#Checks if sprinting
	if Input.is_action_pressed(\"Sprint\"):
		speed = DEFAULT_SPEED * SPRINT_MULT
	else:
		speed = DEFAULT_SPEED
	
	#If the player is moving on the x or y
	var moving_x = false
	var moving_y = false
	
	#Checks y movement and updates player position accordingly
	var y_direction := Input.get_axis(\"Up\", \"Down\")
	if y_direction:
		velocity.y = y_direction * speed
		moving_y = true
		
		if y_direction == 1:
			animated_sprite_2d.play(\"Walk_Down\")
			last_direction = 1
			
		elif y_direction == -1:
			animated_sprite_2d.play(\"Walk_Up\")
			last_direction = 2
			
	else:
		velocity.y = 0
		moving_y = false
		
	
	
	#Checks x movement and updates player position accordingly
	var x_direction := Input.get_axis(\"Left\", \"Right\")
	if x_direction:
		velocity.x = x_direction * speed
		moving_x = true
		
		if x_direction == 1:
			animated_sprite_2d.flip_h = true
			animated_sprite_2d.play(\"Walk_Side\")
			last_direction = 3
			
		elif x_direction == -1:
			animated_sprite_2d.flip_h = false
			animated_sprite_2d.play(\"Walk_Side\")
			last_direction = 3
			
	else:
		velocity.x = 0
		moving_x = false
	
	#Plays idle animation according to last direction if player isn't moving
	if not moving_x and not moving_y:
		if last_direction == 1:
			animated_sprite_2d.play(\"Front_Idle\")
		
		elif last_direction == 2:
			animated_sprite_2d.play(\"Back_Idle\")
			
		elif last_direction == 3:
			animated_sprite_2d.play(\"Side_Idle\")
	
	#Moves the character based off of velocity
	move_and_slide()
"

